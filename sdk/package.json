{
  "name": "json-drop",
  "version": "0.1.0",
  "description": "Firebase-style JavaScript SDK for json-drop",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --minify && tsc -p tsconfig.json",
    "test": "bun test"
  },
  "keywords": [
    "json-drop",
    "database",
    "json",
    "firebase"
  ],
  "license": "MIT"
}
